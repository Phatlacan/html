{
    "name": "phatlacan/html",
    "description": "Phatlacan HTML API",
    "type": "library",
    "require": {
        "php": ">=8.4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpunit/php-code-coverage": "^11.0",
        "squizlabs/php_codesniffer": "^3.11",
        "friendsofphp/php-cs-fixer": "^3.67"
    },
    "license": "AGPL-3.0-or-later",
    "autoload": {
        "psr-4": {
            "Phatlacan\\Html\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phatlacan\\Html\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "t": "phpunit",
        "cs": "phpcs src/",
        "csf": "PHP_CS_FIXER_IGNORE_ENV=1 ./vendor/bin/php-cs-fixer fix src/"
    },
    "authors": [
        {
            "name": "Levent Yumerov",
            "email": "levent@yumerov.com"
        }
    ]
}
